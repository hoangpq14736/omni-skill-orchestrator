+def repair_json_string(s: str) -> Tuple[str, bool]:
+    """
+    Single-pass scanner to repair unescaped quotes, invalid backslashes, and raw newlines
+    inside JSON string values without corrupting valid escapes or delimiters (VULN-009).
+    """
+    result = []
+    in_string = False
+    length = len(s)
+    i = 0
+    repaired = False
+    valid_escapes = {'"', '\\', '/', 'b', 'f', 'n', 'r', 't'}
+
+    while i < length:
+        c = s[i]
+        if not in_string:
+            result.append(c)
+            if c == '"':
+                in_string = True
+            i += 1
+            continue
+
+        # Inside string literal
+        if c == '\\':
+            if i + 1 < length:
+                nxt = s[i + 1]
+                if nxt in valid_escapes:
+                    result.append(c)
+                    result.append(nxt)
+                    i += 2
+                    continue
+                elif nxt == 'u' and i + 5 < length and all(h in "0123456789abcdefABCDEF" for h in s[i + 2:i + 6]):
+                    result.append(s[i:i + 6])
+                    i += 6
+                    continue
+            # Invalid backslash escape -> escape it as \\
+            result.append('\\\\')
+            repaired = True
+            i += 1
+            continue
+
+        if c == '"':
+            j = i + 1
+            while j < length and s[j] in " \t\r\n":
+                j += 1
+            next_char = s[j] if j < length else ""
+            if next_char in {",", "}", "]", ":"}:
+                in_string = False
+                result.append(c)
+            else:
+                result.append('\\"')
+                repaired = True
+            i += 1
+            continue
+
+        if c == '\n':
+            result.append('\\n')
+            repaired = True
+            i += 1
+            continue
+        if c == '\r':
+            result.append('\\r')
+            repaired = True
+            i += 1
+            continue
+        if c == '\t':
+            result.append('\\t')
+            repaired = True
+            i += 1
+            continue
+
+        result.append(c)
+        i += 1
+
+    return "".join(result), repaired
+
+
+def repair_unescaped_json_quotes(s: str) -> str:
+    """Backward compatibility wrapper."""
+    rep, _ = repair_json_string(s)
+    return rep
+
+
+def extract_first_json_object(raw_str: str) -> str:
+    """
+    Extracts the first valid balanced JSON object string from raw_str.
+    Strips markdown code fences and handles trailing non-JSON content.
+    """
+    s = raw_str.strip()
+    if s.startswith("```"):
+        s = re.sub(r"^```(?:json)?\s*", "", s, flags=re.IGNORECASE)
+        s = re.sub(r"\s*```$", "", s)
+        s = s.strip()
+
+    start_idx = s.find('{')
+    if start_idx == -1:
+        return s
+
+    in_string = False
+    escape = False
+    depth = 0
+    end_idx = -1
+    for i in range(start_idx, len(s)):
+        char = s[i]
+        if escape:
+            escape = False
+            continue
+        if char == '\\':
+            escape = True
+            continue
+        if char == '"':
+            in_string = not in_string
+            continue
+        if not in_string:
+            if char == '{':
+                depth += 1
+            elif char == '}':
+                depth -= 1
+                if depth == 0:
+                    end_idx = i + 1
+                    break
+    if end_idx != -1:
+        return s[start_idx:end_idx]
+    return s[start_idx:]
+
