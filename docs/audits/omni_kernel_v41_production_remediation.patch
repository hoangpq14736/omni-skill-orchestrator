+
+    # 2. Resolver warm (with workspace)
+    warm_ws = []
+    for _ in range(30):
+        t0 = time.perf_counter()
+        resolver.resolve_skill("fix docker port conflict 8080", workspace_dir=REPO_ROOT, registry=reg)
+        warm_ws.append((time.perf_counter() - t0) * 1000.0)
