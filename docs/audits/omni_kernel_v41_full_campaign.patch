+
+    while i < length:
+        c = s[i]
+        if not in_string:
+            result.append(c)
+            if c == '"':
+                in_string = True
+            i += 1
+            continue
+
+        # Inside string literal
+        if c == '\\':
+            if i + 1 < length:
+                nxt = s[i + 1]
+                if nxt in valid_escapes:
+                    result.append(c)
+                    result.append(nxt)
+                    i += 2
+                    continue
+                elif nxt == 'u' and i + 5 < length and all(h in "0123456789abcdefABCDEF" for h in s[i + 2:i + 6]):
+                    result.append(s[i:i + 6])
