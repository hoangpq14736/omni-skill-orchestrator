+
+        writer = MemorySingleWriter(db_path)
+        reentrant_caught = []
+
+        def callback(success, err):
+            # Attempt to re-entrantly call enqueue_write from worker callback
+            try:
+                writer.enqueue_write("SELECT 1;")
