+            getattr(errno, "ENOENT", 2),
+            getattr(errno, "ENOSPC", 28),
+            getattr(errno, "EROFS", 30),
+            getattr(errno, "EISDIR", 21),
+            getattr(errno, "ENAMETOOLONG", 36),
+            getattr(errno, "EFBIG", 27),
