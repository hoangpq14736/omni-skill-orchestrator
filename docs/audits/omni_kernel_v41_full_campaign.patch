+def _is_valid_hex_key(k: Any) -> bool:
+    """Enforces exact 64-hex character (256-bit entropy) key provenance."""
+    if not isinstance(k, bytes):
+        if isinstance(k, str):
+            k = k.encode("utf-8")
+        else:
+            return False
+    k = k.strip()
+    if len(k) != 64:
+        return False
+    return all(c in b"0123456789abcdefABCDEF" for c in k)
